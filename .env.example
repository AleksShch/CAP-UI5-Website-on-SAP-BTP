PORT=4004

# HR recipient of all job applications
APPLICATION_TO_EMAIL=your.account@gmail.com

# Personal Google account (requires Google 2-Step Verification and an App Password)
MAIL_PROVIDER=gmail
GMAIL_USER=your.google.account@gmail.com
GMAIL_APP_PASSWORD=replace-with-16-character-app-password
MAIL_FROM_NAME=Bewerbungsportal

# SMTP transport
# Generic SMTP alternative (set MAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=smtp-user
# SMTP_PASS=change-me
# MAIL_FROM=Job Portal <no-reply@example.com>

# Upload protection
MAX_FILE_SIZE_MB=10
MAX_ATTACHMENTS=5

# AI landing-page block generation through OpenRouter
OPENROUTER_API_KEY=replace-with-openrouter-api-key
# Optional management key for the exact account credit balance. Otherwise the remaining API-key limit is shown.
# OPENROUTER_MANAGEMENT_KEY=replace-with-openrouter-management-key
OPENROUTER_MODEL=google/gemini-3.1-pro-preview
# Optional default in the image-model dropdown. Leave empty to avoid automatic image generation.
# OPENROUTER_IMAGE_MODEL=openai/gpt-image-1
OPENROUTER_MANAGEMENT_KEY=replace-with-openrouter-management-key
OPENROUTER_USE_SYSTEM_CA=true


# For BTP
# cf target
# cf apps

# cf set-env cap-job-application-srv OPENROUTER_API_KEY "sk-or-v1-your-key"
# cf set-env cap-job-application-srv OPENROUTER_MODEL "google/gemini-3.1-pro-preview"
# cf set-env cap-job-application-srv OPENROUTER_TIMEOUT_MS "300000"
# cf set-env cap-job-application-srv OPENROUTER_IMAGE_TIMEOUT_MS "600000"
# cf set-env cap-job-application-srv OPENROUTER_SITE_URL "https://web-site.url"
# cf set-env cap-job-application-srv OPENROUTER_APP_NAME "HR Bewerbung"

# cf restage cap-job-application-srv

# OR .env file

# Optional privacy and request settings
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Use trusted certificates from the operating system, for example behind a corporate TLS proxy
OPENROUTER_USE_SYSTEM_CA=true
# Optional: set to deny only when every selected model must use a provider that does not retain prompts.
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ZDR=true
# Maximum waiting time for text and image generation (defaults: 3 and 5 minutes)
OPENROUTER_TIMEOUT_MS=180000
OPENROUTER_IMAGE_TIMEOUT_MS=300000
OPENROUTER_SITE_URL=https://web-site.url
OPENROUTER_APP_NAME=HR Bewerbung


