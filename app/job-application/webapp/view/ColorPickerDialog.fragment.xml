<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:u="sap.ui.unified">
  <Dialog
    id="themeColorPickerDialog"
    title="{i18n>themeColorPickerTitle}"
    contentWidth="30rem"
    stretchOnPhone="true"
    draggable="true"
    resizable="true"
    afterClose=".onColorPickerAfterClose">
    <content>
      <VBox alignItems="Center" class="sapUiMediumMargin">
        <u:ColorPicker id="themeColorPicker" colorString="#FFFFFF" mode="HSL"/>
      </VBox>
    </content>
    <beginButton>
      <Button text="{i18n>themeApplyColor}" type="Emphasized" press=".onApplyColorPicker"/>
    </beginButton>
    <endButton>
      <Button text="{i18n>cancelChanges}" press=".onCancelColorPicker"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
